# Copy to .env (gitignored). Real environment variables win over this file.

# ── LLM: any OpenAI-compatible Responses API (POST {LLM_BASE_URL}/responses) ──
# Local Ollama (default — nothing to set):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:14b
#
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-5-mini
# LLM_NO_TEMPERATURE=1          # reasoning models reject `temperature`
#
# Any other compatible server (vLLM, LM Studio, OpenRouter, ...): set the same three.
# LLM_REASONING_EFFORT=none     # none|low|medium|high; defaults to none for local Ollama
# LLM_TIMEOUT=180

# ── Data: every file the app writes lives here (back up this one folder) ──
# JOB_DASHBOARD_DATA_DIR=data

# ── Agent browser: its own Chrome + profile under <data>/browser/profile ──
# AGENT_CDP_PORT=9333
# AGENT_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CAREER_AGENT_CDP_URL=off      # use Playwright's bundled Chromium instead of the CDP browser

# ── Optional integrations ──
# TINYFISH_API_KEY=             # company research
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
