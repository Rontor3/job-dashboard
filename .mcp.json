{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp",
        "--browser",
        "chromium",
        "--user-data-dir",
        "data/browser/mcp-profile",
        "--output-dir",
        "data/tmp/mcp"
      ],
      "env": {}
    }
  }
}
